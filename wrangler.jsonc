{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vanity",
  "account_id": "b069014f6a46558ea9146fb6c4ff8f6c",
  "main": "worker.js",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "send_metrics": false,
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "phaedrus.io", "custom_domain": true },
    { "pattern": "www.phaedrus.io", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  }
}
